"""Generated by workflowval. Shared test helpers; needs only pytest and httpx to run."""

from __future__ import annotations

import json
import os
import re
import secrets
import uuid
from collections.abc import Generator, Iterator
from contextlib import contextmanager
from typing import Any
from urllib.parse import quote

import httpx
import pytest

BASE_URL = os.environ.get("WORKFLOWVAL_BASE_URL", __BASE_URL__).rstrip("/")
AUTH: dict[str, Any] | None = __AUTH__
TIMEOUT_SECONDS = 30
MASK = "[REDACTED]"
SECRET_HEADERS = {"authorization", "cookie", "set-cookie", "proxy-authorization", "x-api-key"}
if AUTH and AUTH.get("type") == "api_key" and AUTH["location"] == "header":
    SECRET_HEADERS.add(AUTH["name"].lower())

_secrets: set[str] = set()
_exchanges: list[httpx.Response] = []
_MAX_RAW_BODY = 200_000
_recording = True
_results: dict[str, dict[str, Any]] = {}
_steps_run = 0
_known_issue: str | None = None
_PATH_PART = re.compile(r"\.([A-Za-z_][\w-]*)|\[(\d+)\]")
_PLACEHOLDER = re.compile(r"\{([A-Za-z_]\w*)\}")


def _env(name: str) -> str:
    value = os.environ.get(name)
    if not value:
        raise RuntimeError(f"environment variable {name} is not set")
    _secrets.add(value)
    return value


def _mask(text: str) -> str:
    for value in sorted(_secrets, key=len, reverse=True):
        text = text.replace(value, MASK)
    if AUTH and AUTH.get("type") == "api_key" and AUTH["location"] == "query":
        text = re.sub(rf"({re.escape(AUTH['name'])}=)[^&\s]+", rf"\g<1>{MASK}", text)
    return text


def _value_at(document: Any, path: str) -> Any:
    node = document
    for name, index in _PATH_PART.findall(path):
        if name:
            if not isinstance(node, dict) or name not in node:
                raise AssertionError(f"no value at {path} in the response")
            node = node[name]
        else:
            if not isinstance(node, list) or int(index) >= len(node):
                raise AssertionError(f"no value at {path} in the response")
            node = node[int(index)]
    return node


class _LoginAuth(httpx.Auth):
    """Logs in once, reuses the token and logs in again on a 401."""

    requires_response_body = True

    def __init__(self, scheme: dict[str, Any]) -> None:
        self.scheme = scheme
        self.token: str | None = None

    def _login(self) -> Generator[httpx.Request, httpx.Response, None]:
        scheme = self.scheme
        fields = {name: _env(env) for name, env in scheme["body_env"].items()}
        url = BASE_URL + scheme["path"]
        if scheme["method"] == "GET":
            request = httpx.Request("GET", url, params=fields)
        else:
            request = httpx.Request(scheme["method"], url, json=fields)
        request.headers["Accept"] = "application/json"
        request.extensions["workflowval_login"] = True
        response = yield request
        self.token = str(_value_at(response.json(), scheme["token_path"]))
        _secrets.add(self.token)

    def _apply(self, request: httpx.Request) -> None:
        scheme = self.scheme
        request.headers[scheme["token_header"]] = f"{scheme['token_prefix']}{self.token}"

    def auth_flow(self, request: httpx.Request) -> Generator[httpx.Request, httpx.Response, None]:
        if self.token is None:
            yield from self._login()
        self._apply(request)
        response = yield request
        if response.status_code == 401 and self.scheme["refresh_on_401"]:
            yield from self._login()
            self._apply(request)
            yield request


def _record(response: httpx.Response) -> None:
    if _recording and not response.request.extensions.get("workflowval_login"):
        response.read()
        _exchanges.append(response)


def _make_client(*, authenticated: bool) -> httpx.Client:
    options: dict[str, Any] = {}
    if authenticated and AUTH:
        kind = AUTH["type"]
        if kind == "bearer":
            options["headers"] = {"Authorization": f"Bearer {_env(AUTH['token_env'])}"}
        elif kind == "basic":
            options["auth"] = httpx.BasicAuth(_env(AUTH["username_env"]), _env(AUTH["password_env"]))
        elif kind == "api_key" and AUTH["location"] == "header":
            options["headers"] = {AUTH["name"]: _env(AUTH["value_env"])}
        elif kind == "api_key":
            options["params"] = {AUTH["name"]: _env(AUTH["value_env"])}
        elif kind == "login":
            options["auth"] = _LoginAuth(AUTH)
    client = httpx.Client(
        timeout=TIMEOUT_SECONDS, event_hooks={"response": [_record]}, **options
    )
    client.headers["Accept"] = "application/json"
    return client


class Api:
    """What a generated test uses to call the API."""

    def __init__(self, client: httpx.Client, anonymous: httpx.Client) -> None:
        self._client = client
        self._anonymous = anonymous
        self.unique = uuid.uuid4().hex[:12]
        self.unique_int = secrets.randbelow(2**31 - 2) + 1

    def call(
        self,
        method: str,
        template: str,
        *,
        path: dict[str, Any] | None = None,
        params: dict[str, Any] | None = None,
        headers: dict[str, Any] | None = None,
        body: Any = None,
        auth: bool = True,
    ) -> httpx.Response:
        """Send one request. `auth=False` sends it without credentials."""
        global _steps_run
        if _recording:
            _steps_run += 1
        url = template
        for name, value in (path or {}).items():
            url = url.replace("{" + name + "}", quote(str(value), safe=""))
        request_headers = {name: str(value) for name, value in (headers or {}).items()}
        client = self._client if auth else self._anonymous
        options: dict[str, Any] = {"params": params, "headers": request_headers}
        if body is not None:
            options["json"] = body
        return client.request(
            method, BASE_URL + url, extensions={"workflowval_template": template}, **options
        )

    def known_issue(self, reason: str) -> None:
        """Note that this test has a failure already reviewed as real."""
        global _known_issue
        _known_issue = reason

    def expected_failure(self) -> None:
        """End the test as an expected failure, with the reviewed reason."""
        pytest.xfail(_known_issue or "known issue")

    @contextmanager
    def expected_failure_on_assert(self) -> Iterator[None]:
        """Treat a failed check inside this block as the reviewed failure."""
        try:
            yield
        except AssertionError:
            self.expected_failure()

    def cleanup(self, method: str, template: str, **options: Any) -> None:
        """Remove test data. A failure here must not hide the test's own result."""
        global _recording
        _recording = False
        try:
            self.call(method, template, **options)
        except httpx.HTTPError:
            pass
        finally:
            _recording = True

    def value(self, response: httpx.Response, path: str) -> Any:
        """Read a value from a JSON response, like $.a.b[0]."""
        try:
            document = response.json()
        except ValueError as exc:
            raise AssertionError(f"response isn't JSON: {response.text[:200]}") from exc
        return _value_at(document, path)

    def fill(self, text: str, saved: dict[str, Any]) -> str:
        """Replace {placeholders} inside a longer string."""
        known = {**saved, "unique": self.unique, "unique_int": self.unique_int}
        return _PLACEHOLDER.sub(lambda match: str(known[match.group(1)]), text)


@pytest.fixture
def api() -> Generator[Api, None, None]:
    """One API helper per test, with fresh unique values."""
    global _steps_run, _known_issue
    _exchanges.clear()
    _steps_run = 0
    _known_issue = None
    with _make_client(authenticated=True) as client, _make_client(authenticated=False) as anon:
        yield Api(client, anon)


def _body(content: bytes) -> Any:
    text = _mask(content.decode("utf-8", errors="replace"))[:4000]
    try:
        return json.loads(text)
    except ValueError:
        return text


def _headers(headers: httpx.Headers) -> dict[str, str]:
    return {
        name: MASK if name.lower() in SECRET_HEADERS else _mask(value)
        for name, value in headers.items()
    }


def _exchange(response: httpx.Response) -> dict[str, Any]:
    request = response.request
    return {
        "method": request.method,
        "url": _mask(str(request.url)),
        "request_headers": _headers(request.headers),
        "request_body": _body(request.content) if request.content else None,
        "status": response.status_code,
        "response_headers": _headers(response.headers),
        "response_body": _body(response.content) if response.content else None,
    }


def _call(response: httpx.Response) -> dict[str, Any]:
    """One request and its whole response, for checking against the spec."""
    return {
        **_exchange(response),
        "template": response.request.extensions.get("workflowval_template"),
        "content_type": response.headers.get("content-type"),
        "raw_body": _mask(response.content.decode("utf-8", errors="replace"))[:_MAX_RAW_BODY],
    }


def pytest_runtest_logreport(report: pytest.TestReport) -> None:
    """Record each test's outcome and its last 3 HTTP exchanges."""
    if report.when == "call" or report.outcome == "failed":
        crash = getattr(report.longrepr, "reprcrash", None)
        message = crash.message if crash else str(report.longrepr or "")
        _results[report.nodeid] = {
            "status": "xfailed" if hasattr(report, "wasxfail") else report.outcome,
            "duration_s": report.duration,
            "failing_assertion": _mask(message) if report.failed else None,
            "stdout": _mask(report.capstdout),
            "exchanges": [_exchange(response) for response in _exchanges[-3:]],
            "calls": [_call(response) for response in _exchanges],
            "steps_run": _steps_run,
            "known_issue": _mask(_known_issue) if _known_issue else None,
        }


def pytest_collectreport(report: pytest.CollectReport) -> None:
    """Record test files that can't even be imported."""
    if report.failed:
        _results[report.nodeid] = {
            "status": "error",
            "duration_s": 0.0,
            "failing_assertion": _mask(str(report.longrepr))[-2000:],
            "stdout": "",
            "exchanges": [],
        }


def pytest_terminal_summary(terminalreporter: Any) -> None:
    """Say when a test marked as a known issue passed, so the bug may be fixed."""
    for node_id, result in _results.items():
        if result["status"] == "passed" and result.get("known_issue"):
            terminalreporter.write_line(f"{node_id} passed; this may be fixed: {result['known_issue']}")


def pytest_sessionfinish() -> None:
    """Write results for workflowval, when it's the one running these tests."""
    path = os.environ.get("WORKFLOWVAL_CAPTURE")
    if path:
        with open(path, "w", encoding="utf-8") as handle:
            json.dump(_results, handle, default=str)
